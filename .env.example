# Copy to .env; never commit actual keys. Blank fields keep real processing off.
AIGHT_OPENAI_API_KEY=
# Use a model available to your account that supports strict JSON schema output.
AIGHT_CHAT_MODEL=
AIGHT_EMBEDDING_MODEL=text-embedding-3-small
# Publish the actual processing notice before enabling personal-document uploads.
AIGHT_NOTICE_VERSION=
AIGHT_NOTICE_URL=
AIGHT_PROCESSOR_RETENTION=
AIGHT_PROCESSOR_REGION=
# Set a long random value for stable, pseudonymous network rate limiting.
AIGHT_LOG_NETWORK_SALT=
AIGHT_ALLOWED_ORIGINS=http://localhost:5080,http://127.0.0.1:5080
